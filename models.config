# Preview AI — 로컬 모델 설정 (TOML 형식)
# 이 파일 값을 바꾸고 사이드카를 재시작하면 적용됩니다.
#   (터미널 2에서 Ctrl+C 후 다시 `uvicorn server:app --port 8765`)
#
# 우선순위: 환경변수 > 이 파일 > RAM 용량 자동 선택
# 값을 비우면("") 해당 항목은 RAM 용량에 맞춰 자동 선택됩니다.

[models]
# 요약·구조화 LLM (Ollama). 예: "qwen3:8b" / "qwen3:14b" / "qwen3:30b"
llm = "qwen3:8b"

# 키프레임 장면 설명 VLM (Ollama). 예: "qwen2.5vl:3b" / "qwen2.5vl:7b"
vlm = "qwen2.5vl:3b"

# 추천도 연관성 임베딩 (Ollama). 예: "bge-m3" / "nomic-embed-text"
embed = "bge-m3"

# 음성 인식 STT — Qwen3-ASR (MLX). 8-bit 기본(품질 ≈ bf16, 용량 ≈2.4GB).
#   최고 정확도: "mlx-community/Qwen3-ASR-1.7B-bf16" / 최경량: "...-4bit"
asr = "mlx-community/Qwen3-ASR-1.7B-8bit"

[ollama]
host = "http://localhost:11434"

[scoring]
# 추천도 = relevance*weight_relevance + quality*weight_quality (합 1.0 권장)
weight_relevance = 0.7
weight_quality = 0.3
# 추천도 색상 임계값(%)
threshold_green = 80   # 이상이면 초록
threshold_yellow = 50  # 이상이면 노랑, 미만이면 빨강

[preprocess]
# 무음 판정 기준(dBFS). 이 값보다 작으면 "음성 없음"으로 분기.
silence_dbfs = -45.0
# 키프레임 샘플 개수 범위 + 분당 장수
keyframe_min = 1
keyframe_max = 8
keyframe_per_minute = 1.0
