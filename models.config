# Preview AI — 로컬 모델 설정 (TOML 형식)
# 이 파일 값을 바꾸고 사이드카를 재시작하면 적용됩니다.
#   (터미널 2에서 Ctrl+C 후 다시 `uvicorn server:app --port 8765`)
#
# 우선순위: 환경변수 > 이 파일 > RAM 용량 자동 선택
# 값을 비우면("") 해당 항목은 RAM 용량에 맞춰 자동 선택됩니다.

[models]
# 요약·구조화 LLM (Ollama). 예: "qwen3:8b" / "qwen3:14b" / "qwen3:30b"
llm = "qwen3:8b"

# 키프레임 장면 설명 VLM (Ollama). 예: "qwen2.5vl:3b" / "qwen2.5vl:7b"
vlm = "qwen2.5vl:3b"

# 추천도 연관성 임베딩 (Ollama). 예: "bge-m3" / "nomic-embed-text"
embed = "bge-m3"

# 음성 인식 STT — Qwen3-ASR (MLX). 4-bit(용량 ≈1.2GB, 정확도 ≈8bit, 더 빠름).
#   최고 정확도: "mlx-community/Qwen3-ASR-1.7B-8bit"(2.4GB)/"-bf16"
#   최경량·최속: "mlx-community/Qwen3-ASR-0.6B-4bit"(0.5GB)
asr = "mlx-community/Qwen3-ASR-1.7B-4bit"

[ollama]
host = "http://localhost:11434"

[scoring]
# 추천도 = relevance*weight_relevance + quality*weight_quality (합 1.0 권장)
weight_relevance = 0.7
weight_quality = 0.3
# 추천도 색상 임계값(%)
threshold_green = 80   # 이상이면 초록
threshold_yellow = 50  # 이상이면 노랑, 미만이면 빨강

[preprocess]
# 무음 판정 기준(dBFS). 이 값보다 작으면 "음성 없음"으로 분기.
silence_dbfs = -45.0
# 키프레임 샘플 개수 범위 + 분당 장수 (균등 폴백 및 상·하한)
keyframe_min = 1
keyframe_max = 8
keyframe_per_minute = 1.0

# 장면 전환 검출 기반 키프레임 선택
scene_detect = true        # false면 균등 간격 샘플링
scene_threshold = 0.5      # 히스토그램 차이(0~1). 낮을수록 컷을 더 민감하게 잡음
scene_sample_fps = 2.0     # 장면 스캔 시 초당 검사 프레임 수(높을수록 정밀·느림)

# 표 호버 스크럽 미리보기: 몇 초당 1프레임을 뽑을지(작을수록 촘촘·용량↑)
scrub_interval = 1.0

[runtime]
# 동시에 분석할 클립 수 (0 = RAM 기준 자동: 16GB→1, 24~32GB→2, 48GB+→3)
# 올리면 한 클립의 GPU 추론 중 다른 클립의 CPU 전처리(ffmpeg·키프레임·장면검출)가
# 겹쳐 더 빨라집니다. 다만 너무 높이면(예: 4↑) Ollama가 모델을 자주 바꿔 로드/언로드
# 하느라 오히려 느려질 수 있어, 2~3 권장.
concurrency = 2
